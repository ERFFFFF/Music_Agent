# Music Agent — every secret the app uses, and the only place any of them belong.
#
# Copy this to `.env` beside the app and fill in what your mode needs. The app reads it on every run
# and NEVER writes to it; nothing here is ever copied into cadence_config.txt, so rotating a key means
# editing this one file. `.env` is gitignored — keep it that way, and treat anything that ever reached
# a commit as compromised.
#
# Keys are matched case-insensitively, blank values are ignored (so leave a line empty to unset it),
# and a `#` inside a value is part of the value, not a comment — passwords contain them.

# ---------------------------------------------------------------------------- which mode to run in
# cadence = your own Cadence server drives playback in an open browser tab
# spotify = this machine's Spotify Connect device via the Spotify Web API
# Optional: without it the app uses whatever `mode` is saved in cadence_config.txt (default: cadence).
MODE=cadence

# ------------------------------------------------------------------------------------ cadence mode
# Your Cadence server. A bare host is fine — https:// is assumed. CADENCE_URL is accepted as an alias.
DOMAIN=music.example.com

# The Cadence account the agent signs in as. The app exchanges these for a session cookie once and
# stores the COOKIE, never the password. CADENCE_USERNAME / CADENCE_PASSWORD are accepted as aliases.
USERNAME=your_cadence_username
PASSWORD=your_cadence_password

# Cloudflare Access service token — only if the Cadence host sits behind Access. A native app cannot
# complete the interactive Access login, so this is the supported headless path: Zero Trust → Access →
# Service Auth, then allow the token on that application's policy. Leave both empty otherwise; half a
# token is worse than none, because it gets sent, rejected, and looks like a Cadence fault.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ------------------------------------------------------------------------------------ spotify mode
# A Spotify app of your own: developer.spotify.com/dashboard. Controlling playback needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must be a loopback IP LITERAL with a port — `localhost` has been invalid since November 2025 — and
# must match the app's registered redirect URI character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ----------------------------------------------------------------------------------- the shortcuts
# One key per action, `HOTKEY_` + the action id. Optional and independent: set one and the other four
# keep their defaults. A shortcut set here is owned here — `music_agent_cli.py hotkeys <action>` will
# refuse to change it and tell you to edit this file, rather than accepting it and quietly not saving.
#
# Format is `modifier+modifier+key`: ctrl, alt, shift, win, plus ONE key (a letter, a digit, f1-f24,
# up/down/left/right, space, enter, esc, tab, home, end, pageup, pagedown, delete, insert).
# Windows gives one combination to one application, so if another app already holds one, `run` says
# which and carries on with the rest.
HOTKEY_PLAY_PAUSE=ctrl+alt+up
HOTKEY_NEXT_TRACK=ctrl+alt+right
HOTKEY_PREVIOUS_TRACK=ctrl+alt+left
HOTKEY_LIKE_UNLIKE=ctrl+alt+l
HOTKEY_SHOW_CURRENT=ctrl+alt+c
