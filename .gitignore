# Secrets — never commit a real one. (.env WAS committed in plaintext until 2026-08-05; the
# git-crypt filter in .gitattributes never actually encrypted it. See .env.example.)
.env

# Ignore all .cache files
.cache

# Exclude exe generation files
main.spec
/dist/
/build/
Music Agent.spec
music_agent_control.log

# Installer output
/installer_output/

# Local state of a portable/dev run (config + the saved Cadence session cookie)
__pycache__/
cadence_config.txt
cadence_config.txt.tmp
config.json
cadence_session.json
MusicAgent.spec